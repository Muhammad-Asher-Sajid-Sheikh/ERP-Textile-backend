// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGEMENT
  PRODUCTION
  MERCHANDISE
  MARKETING
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AuditActionType {
  REGISTERED
  APPROVED
  REJECTED
  SUSPENDED
  ROLE_CHANGED
  PASSWORD_CHANGED
  LOGIN_ATTEMPT
  LOGIN_FAILED
  BOM_CREATED
  BOM_UPDATED
  BOM_DELETED

  OWI_CREATED
  OWI_UPDATED
  OWI_DELETED

  CREATE
  READ
  UPDATE
  DELETE
}

model User {
  technicalReviewsSubmitted InquiryTechnicalReview[] @relation("ReviewSubmitter")
  id                        String                   @id @default(uuid())
  email                     String                   @unique
  passwordHash              String
  name                      String
  role                      Role                     @default(PRODUCTION)
  status                    AccountStatus            @default(PENDING)
  department                String?
  isPasswordChanged         Boolean                  @default(false)
  loginAttempts             Int                      @default(0)
  lastLoginAt               DateTime?
  lastLoginIp               String?
  lockedUntil               DateTime?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime?                @updatedAt

  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  customersCreated       Customer[]                   @relation("CustomerCreator")
  customersUpdated       Customer[]                   @relation("CustomerModifier")
  inquiriesCreated       Inquiry[]                    @relation("InquiryCreator")
  inquiriesAssigned      Inquiry[]                    @relation("InquiryMerchandiser")
  evidenceUploaded       InquiryEvidence[]
  inquiryChanges         InquiryStatusHistory[]
  acknowledgements       InquiryAcknowledgement[]
  businessAuditLogs      BusinessAuditLog[]
  technicalReviews       InquiryTechnicalReview[]     @relation("ReviewCreator")
  productionReviews      InquiryTechnicalReview[]     @relation("ProductionReviewer")
  reviewItems            TechnicalReviewItem[]
  consultations          ProductionConsultation[]
  clarificationsCreated  CustomerClarification[]      @relation("ClarificationCreator")
  clarificationsAssigned CustomerClarification[]      @relation("ClarificationOwner")
  clarificationResponses ClarificationResponse[]
  baselinesCreated       RequirementBaselineVersion[]
  provisionalRequests    ProvisionalReviewRequest[]   @relation("ProvisionalRequester")
  provisionalReviews     ProvisionalReviewRequest[]   @relation("ProvisionalReviewer")
  provisionalDecisions   ProvisionalReviewDecision[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType    AuditActionType
  actionDetails String?
  performedBy   String?
  ipAddress     String?
  timestamp     DateTime        @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([actionType])
}

model OrderToken {
  id              String          @id @default(uuid())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// MERCHANDISE Department

enum SampleType {
  APPROVAL_SAMPLE
  PHOTO_SAMPLE
  PPS
  PACKING_SAMPLE
}

enum InternalQcStatus {
  PENDING
  PASSED
  FAILED
}

enum CustomerSampleStatus {
  PENDING
  APPROVED
  DISAPPROVED
}

enum ReasonCategory {
  SHADE_MISMATCH
  MEASUREMENT_DEFECT
  CONSTRUCTION_ERROR
  FABRIC_QUALITY
  TRIM_PACKING_DEFECT
  OTHER
}


//PPS
model PreProductionSample {
  id              String               @id @default(uuid())
  icnNo           String
  sampleType      SampleType           @default(PPS)
  ppsVersion      Int                  @default(1)
  
  // Relational Link to OWI
  owiId           String
  owi             String  //OrderWorkingInstruction @relation(fields: [owiId], references: [id])

  //rackId          String               // Storage rack reference (e.g., "1", "R-02")
  // 1-to-1 back-relation (FK lives on RackRetention)
  rackRetention   RackRetention?
  
  qcStatus        InternalQcStatus     @default(PENDING)
  isApproved      Boolean              @default(false) // Internal Management Sign-off
  isLocked        Boolean              @default(false)

  dispatchDate    DateTime?
  receivedDate    DateTime?
  
  status          CustomerSampleStatus @default(PENDING) // Customer Feedback Status
  reasonCategory  ReasonCategory?
  remarks         String?              @db.Text

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([icnNo])
  @@index([owiId])
  @@map("pre_production_samples")
}


// T&A Planning
enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum Department {
  MERCHANDISING
  SCM
  PRODUCTION
  QUALITY
  ACCOUNTS
}

// 1. Parent T&A Header Model
model TimeActionPlan {
  id                 String           @id @default(uuid())
  icnNo              String
  owiId              String
  owi                String           //OrderWorkingInstruction @relation(fields: [owiId], references: [id])
  
  orderDate          DateTime
  shipmentDeadline   DateTime
  totalLeadTimeDays  Int              // Auto-calculated total duration
  
  // Relation: One T&A plan has many stages stored in a proper table
  stages             TimeActionStage[]
  masterLots         MasterLot[] 
  
  taVersion          Int              @default(1)
  isLocked           Boolean          @default(false)
  criticalPathFlag   Boolean          @default(false)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([icnNo])
  @@index([owiId])
  @@map("time_action_plans")
}

// 2. Child Stage Model (Enforces Enums & Individual Database Rows)
model TimeActionStage {
  id                    String         @id @default(uuid())
  timeActionPlanId      String
  timeActionPlan        TimeActionPlan @relation(fields: [timeActionPlanId], references: [id], onDelete: Cascade)
  
  stageName             String
  plannedStartDate      DateTime?
  plannedEndDate        DateTime?
  actualStartDate       DateTime?
  actualEndDate         DateTime?
  
  // Optional until assigned during T&A planning
  responsibleDepartment Department?     
  status                StageStatus    @default(PENDING)

  @@index([timeActionPlanId])
  @@index([status])
  @@index([responsibleDepartment])
  @@map("time_action_stages")
}


//Bill Of Materials

enum BomCategory {
  YARN
  FABRIC
  DYE_CHEMICAL
  TRIM_ACCESSORY
  PACKING
  OTHER
}

enum BomStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REVISED
  SUPERSEDED
}

enum ChargingCriteria {
  PER_PIECE          // Multiplies against total order pieces
  PER_SET            // Multiplies against total order sets
  PER_KG_WEIGHT      // Multiplies against total greige/finished weight
  OWF_PERCENT        // % On Weight of Fabric (for dyes/chemicals)
  PER_CARTON         // Multiplies against calculated carton count
  FIXED_ORDER_TOTAL  // Flat quantity for the entire order
}

model OrderBom {
  id              String         @id @default(uuid())
  icnNo           String         // Links to Inquiry Control Number
  atxScIon        String?        // Links to governing ATX SC / ION
  skuId           String         // Links to the specific Article/SKU
  
  version         Int            @default(1)
  status          BomStatus      @default(DRAFT)
  revisionReason  String?        // Required when version > 1
  
  // Audit & Governance
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  
  items                 OrderBomItem[]
  workingInstructions   OrderWorkingInstruction[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([icnNo, skuId, version])
  @@index([icnNo])
  @@index([atxScIon])
  @@map("order_boms")
}

model OrderBomItem {
  id                   String           @id @default(uuid())
  bomId                String
  bom                  OrderBom         @relation(fields: [bomId], references: [id])

  // 1. User-Selected Selectors (Flexible for any item)
  category             BomCategory
  componentRole        String?          // Optional tag: "PILE", "GROUND", "NORMAL_WEFT", "BORDER_WEFT", "MAIN_LABEL", etc.
  materialCode         String?          // Optional link to Inventory/Material Master
  materialName         String
  specification        String?          // Free-text specs (e.g., "20/1 Carded Cotton" or "Satin Care Label")
  stageCode            String?          // Optional link to consuming stage (e.g., "WEAVING", "STITCHING")

  // 2. Variant Targeting (Null = applies to all shades/sizes)
  applicableShade      String?
  applicableSize       String?

  // 3. Calculation & Unit Selectors
  chargingCriteria     ChargingCriteria
  uom                  String           // Consumption UOM: kg, lbs, mtr, pcs, cones, cartons
  baseQuantity         Decimal          @db.Decimal(12, 4) // Order pieces, sets, or fabric kg this applies to
  consumptionRate      Decimal          @db.Decimal(10, 4) // Net usage per unit of chargingCriteria
  allowancePercent     Decimal          @default(0) @db.Decimal(5, 2) // Product/stage-specific wastage %
  
  // 4. Procurement Unit Conversion (Optional)
  purchaseUom          String?          // e.g., "cones", "rolls", "drums"
  conversionFactor     Decimal          @default(1) @db.Decimal(10, 4)

  // 5. System-Calculated & Reconciled Quantities
  estimatedRequiredQty Decimal          @db.Decimal(12, 4) // Calculated: baseQuantity * consumptionRate * (1 + allowance%)
  actualFirstBatchRate Decimal?         @db.Decimal(10, 4) // Recorded after WF-14 Gate A trial lot
  actualConsumedQty    Decimal          @default(0) @db.Decimal(12, 4)
  procuredQty          Decimal          @default(0) @db.Decimal(12, 4)
  usableStockQty       Decimal          @default(0) @db.Decimal(12, 4)

  // 6. Frozen ECS Baseline Link (for FBS calculation)
  ecsLineItemId        String?          // Links to the approved ECS item
  ecsFrozenUnitRate    Decimal          @db.Decimal(12, 4) // Locked rate from ECS (never overwritten)
  totalBudgetedCost    Decimal          @db.Decimal(14, 2) // Calculated: estimatedRequiredQty * ecsFrozenUnitRate

  // 7. Extra Unforeseen Attributes (Safety Valve)
  extraAttributes      Json?            // PostgreSQL JSONB for any extra buyer/technical notes

  // 8. Soft-Delete / Audit Compliance
  isActive             Boolean          @default(true)
  remarks              String?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([bomId, stageCode])
  @@map("order_bom_items")
}


//Order Working Instructions

enum OwiStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

model OrderWorkingInstruction {
  id              String     @id @default(uuid())
  icnNo           String
  atxScIon        String?
  skuId           String
  orderBomId      String?
  orderBom        OrderBom?  @relation(fields: [orderBomId], references: [id])

  // Static B3/B4 Product Spec fields stored in PostgreSQL
  productFamily   String?
  construction    String?
  composition     String?
  gsmOrWeight     String?
  dimensions      String?
  shadeOrColour   String?
  finish          String?
  packingSpec     String?

  // Version Control & MongoDB Payload Link
  version         Int        @default(1)
  status          OwiStatus  @default(DRAFT)
  mongoPayloadId  String     // ObjectId string pointing to MongoDB OWI stage document
  revisionReason  String?

  // Governance & Audit
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([icnNo, skuId, version])
  @@index([icnNo])
  @@index([atxScIon])
  @@map("order_wip_instructions")
}



// PRODUCTION

// Broker
enum BrokerPartyType {
  BROKER
  AGENT
  THIRD_PARTY
}

model Broker {
  id              String                   @id @default(uuid())
  brokerName      String                   // Name of the broker, agent, or third-party
  partyType       BrokerPartyType          @default(BROKER)
  contactPerson   String?
  email           String?
  phone           String?

  // Relation to broker tracking records
  trackingRecords BrokerThirdPartyRecord[]

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@map("brokers")
}

model BrokerThirdPartyRecord {
  id            String   @id @default(uuid())
  icnNo         String
  
  brokerId      String
  broker        Broker   @relation(fields: [brokerId], references: [id])
  
  stage         String   // e.g., Commission Agreement, Sample Dispatch, Payment Clearance
  priceCost     Float    // Commission amount or agreed financial cost
  
  dateToSent    DateTime?
  dateToReceive DateTime?
  
  isApproved    Boolean  @default(false) // Management sign-off flag

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([icnNo])
  @@index([brokerId])
  @@map("broker_third_party_records")
}

enum StoreInventoryStatus {
  RECEIVED
  QA_HOLD
  ACCEPTED_AVAILABLE
  RESERVED
  ISSUED
  CONSUMED
}

model Store {
  id           String               @id @default(uuid())
  icnNo        String?
  materialType String
  quantity     Float
  status       StoreInventoryStatus @default(RECEIVED)

  createdBy    String?
  updatedBy    String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([icnNo])
  @@index([status])
  @@map("store_inventory")
}

model RackRetention {
  id               String              @id @default(uuid())
  ppsId            String              @unique
  pps              PreProductionSample @relation(fields: [ppsId], references: [id], onDelete: Restrict)

  // Physical Storage & Counter-Sample Control
  sampleCode       String              // Human-readable Sample ID / reference code
  rackLocation     String              // e.g., "Rack-02 / Bin-B4"
  custodianId      String              // Authenticated user ID responsible for physical custody
  markingNotes     String?             // Physical tag/label/seal details on the counter-sample
  photoUrls        String[]            // Photographic evidence before dispatch

  // Retention Lifecycle & Audit
  retainedAt       DateTime            @default(now())
  isActive         Boolean             @default(true) // False if superseded by a revised PPS
  supersededReason String?
  createdBy        String
  updatedBy        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([rackLocation])
  @@map("rack_retentions")
}


enum ActiveGate {
  GATE_A
  GATE_B
  GATE_C
}

enum StageLotStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  HOLD
}

model MasterLot {
  id               String         @id @default(uuid())
  lotCode          String         @unique
  tnaId            String
  tna              TimeActionPlan @relation(fields: [tnaId], references: [id], onDelete: Restrict)

  activeGate       ActiveGate     @default(GATE_A)
  isApproved       Boolean        @default(false)
  targetQuantity   Int?
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  remarks          String?        @db.Text

  stageLots        StageWiseLot[]

  createdBy        String
  updatedBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([tnaId])
  @@index([activeGate])
  @@map("master_lots")
}

model StageWiseLot {
  id               String         @id @default(uuid())
  masterLotId      String
  masterLot        MasterLot      @relation(fields: [masterLotId], references: [id], onDelete: Cascade)

  gate             ActiveGate
  stageName        String
  stageSequence    Int
  allocatedQty     Int
  completedQty     Int?           @default(0)
  rejectedQty      Int?           @default(0)

  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?

  status           StageLotStatus @default(SCHEDULED)
  notes            String?        @db.Text

  createdBy        String
  updatedBy        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([masterLotId, gate, stageSequence])
  @@index([masterLotId])
  @@index([gate])
  @@index([status])
  @@map("stage_wise_lots")
}




//MARKETING
enum InquirySource {
  EMAIL
  WHATSAPP
  WEBSITE
  BUYING_AGENT
  MEETING
  TELEPHONE
  OTHER
}

enum InquiryStatus {
  RECEIVED
  REGISTERED
  ACKNOWLEDGED
  DUPLICATE_LINKED
  ON_HOLD
  CLOSED
}

enum InquiryPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CommercialPartyRole {
  LEGAL_BUYER
  BUYER
  AGENT
  ACCOUNT_OWNER
  REMITTER
  CONSIGNEE
  ULTIMATE_CUSTOMER
}

model Customer {
  id            String                 @id @default(uuid())
  code          String                 @unique
  name          String
  country       String
  customerType  String?
  active        Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  createdById   String
  updatedById   String
  createdBy     User                   @relation("CustomerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy     User                   @relation("CustomerModifier", fields: [updatedById], references: [id], onDelete: Restrict)
  contacts      CustomerContact[]
  relationships CustomerRelationship[] @relation("CustomerParties")
  relatedTo     CustomerRelationship[] @relation("RelatedParty")
  inquiries     Inquiry[]
  sequences     IrnSequence[]

  @@index([active, name])
}

model CustomerContact {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  name        String
  email       String?
  phone       String?
  designation String?

  @@index([customerId])
}

model CustomerRelationship {
  id         String              @id @default(uuid())
  customerId String
  partyId    String
  role       CommercialPartyRole
  customer   Customer            @relation("CustomerParties", fields: [customerId], references: [id], onDelete: Restrict)
  party      Customer            @relation("RelatedParty", fields: [partyId], references: [id], onDelete: Restrict)

  @@unique([customerId, partyId, role])
  @@index([partyId])
}

model IrnSequence {
  customerId String
  year       Int
  lastValue  Int
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@id([customerId, year])
}

model Inquiry {
  id                   String                       @id @default(uuid())
  irn                  String                       @unique
  irnYear              Int
  irnSerial            Int
  customerId           String
  customer             Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  source               InquirySource
  sourceReference      String?
  receivedAt           DateTime
  productCategory      String?
  seasonProgram        String?
  destination          String?
  estimatedQuantity    Decimal?                     @db.Decimal(20, 4)
  quantityUnit         String?
  targetDate           DateTime?                    @db.Date
  merchandiserId       String
  merchandiser         User                         @relation("InquiryMerchandiser", fields: [merchandiserId], references: [id], onDelete: Restrict)
  priority             InquiryPriority              @default(NORMAL)
  responseDueAt        DateTime
  nextAction           String
  status               InquiryStatus                @default(REGISTERED)
  statusReason         String?
  duplicateOfId        String?
  duplicateOf          Inquiry?                     @relation("DuplicateInquiry", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates           Inquiry[]                    @relation("DuplicateInquiry")
  originalEvidenceHash String
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  createdById          String
  createdBy            User                         @relation("InquiryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  evidence             InquiryEvidence[]
  history              InquiryStatusHistory[]
  acknowledgements     InquiryAcknowledgement[]
  technicalReviews     InquiryTechnicalReview[]
  clarifications       CustomerClarification[]
  baselines            RequirementBaselineVersion[]
  provisionalRequests  ProvisionalReviewRequest[]

  @@unique([customerId, irnYear, irnSerial])
  @@index([customerId, createdAt])
  @@index([merchandiserId, status])
  @@index([status, responseDueAt])
  @@index([customerId, originalEvidenceHash])
  @@index([customerId, sourceReference])
  @@index([duplicateOfId])
}

model InquiryEvidence {
  id                 String            @id @default(uuid())
  inquiryId          String
  inquiry            Inquiry           @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  source             InquirySource
  receivedAt         DateTime
  message            String?
  reference          String?
  correctsEvidenceId String?
  correctsEvidence   InquiryEvidence?  @relation("EvidenceCorrection", fields: [correctsEvidenceId], references: [id], onDelete: Restrict)
  corrections        InquiryEvidence[] @relation("EvidenceCorrection")
  filename           String?
  mediaType          String?
  byteSize           Int?
  attachmentBytes    Bytes?
  attachmentSha256   String?
  contentSha256      String
  uploadedById       String
  uploadedBy         User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt          DateTime          @default(now())

  reviewItems            TechnicalReviewItem[]
  clarificationResponses ClarificationResponse[]
  baselineAssertions     BaselineAssertion[]

  @@index([inquiryId, createdAt])
  @@index([correctsEvidenceId])
}

model InquiryAcknowledgement {
  id             String        @id @default(uuid())
  inquiryId      String
  inquiry        Inquiry       @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  acknowledgedAt DateTime
  channel        InquirySource
  recipient      String
  message        String?
  reference      String?
  recordedById   String
  recordedBy     User          @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt      DateTime      @default(now())

  @@index([inquiryId, createdAt])
}

model InquiryStatusHistory {
  id             String         @id @default(uuid())
  inquiryId      String
  inquiry        Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  previousStatus InquiryStatus?
  newStatus      InquiryStatus
  changedById    String
  changedBy      User           @relation(fields: [changedById], references: [id], onDelete: Restrict)
  reason         String?
  notes          String?
  createdAt      DateTime       @default(now())

  @@index([inquiryId, createdAt])
}

model BusinessAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action     String
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  reason     String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

// WF-02 outcomes do not change the WF-01 inquiry lifecycle.
enum TechnicalReviewOutcome {
  COMPLETE_FOR_CLARIFICATION_BASELINE
  CUSTOMER_CLARIFICATION_REQUIRED
  TECHNICAL_REVIEW_PENDING
  FEASIBLE_WITH_ASSUMPTIONS
  NOT_FEASIBLE
}

enum RequirementState {
  VERIFIED
  UNVERIFIED
  MISSING
  ASSUMED
  NOT_APPLICABLE
}

enum RequirementArea {
  PRODUCT
  QUANTITY
  COMMERCIAL
  TIMING
  PACKING
  QUALITY
}

enum RequirementStage {
  QUOTATION
  SAMPLE
  ORDER_ACTIVATION
}

enum ConsultationConclusion {
  SUPPORTED
  TECHNICAL_HOLD
  NOT_FEASIBLE
}

enum ConfirmationState {
  UNANSWERED
  WRITTEN_CONFIRMATION_PENDING
  WRITTEN_CONFIRMED
}

enum BaselineOutcome {
  BASELINE_READY_FOR_FEASIBILITY
  CLARIFICATION_PENDING
  CUSTOMER_HOLD
}

enum ProvisionalDisposition {
  REJECTED
  RETURNED_FOR_INFORMATION
}

model InquiryTechnicalReview {
  submittedById          String?
  submittedBy            User?                        @relation("ReviewSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  id                     String                       @id @default(uuid())
  inquiryId              String
  inquiry                Inquiry                      @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  version                Int
  revision               Int                          @default(1)
  productFamily          String
  applicabilityReference String?
  assumptions            String[]
  notes                  String?
  outcome                TechnicalReviewOutcome?
  submittedAt            DateTime?
  createdById            String
  createdBy              User                         @relation("ReviewCreator", fields: [createdById], references: [id], onDelete: Restrict)
  productionReviewerId   String?
  productionReviewer     User?                        @relation("ProductionReviewer", fields: [productionReviewerId], references: [id], onDelete: Restrict)
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  items                  TechnicalReviewItem[]
  consultations          ProductionConsultation[]
  baselines              RequirementBaselineVersion[]
  provisionalRequests    ProvisionalReviewRequest[]

  @@unique([inquiryId, version])
  @@index([productionReviewerId])
  @@index([outcome, submittedAt])
}

model TechnicalReviewItem {
  id                  String                  @id @default(uuid())
  reviewId            String
  review              InquiryTechnicalReview  @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  key                 String
  area                RequirementArea
  label               String
  state               RequirementState
  value               String?
  requiredFor         RequirementStage[]
  applicabilityReason String
  needsProduction     Boolean                 @default(false)
  evidenceId          String?
  evidence            InquiryEvidence?        @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  ownerId             String?
  owner               User?                   @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  dueAt               DateTime?
  followUpAt          DateTime?
  escalationReason    String?
  questions           ClarificationQuestion[]

  @@unique([reviewId, key])
  @@index([ownerId, dueAt])
  @@index([evidenceId])
}

// Production records its own conclusion against an exact draft revision.
model ProductionConsultation {
  id             String                 @id @default(uuid())
  reviewId       String
  review         InquiryTechnicalReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  reviewRevision Int
  conclusion     ConsultationConclusion
  findings       String
  assumptions    String[]
  recordedById   String
  recordedBy     User                   @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt      DateTime               @default(now())

  @@index([reviewId, reviewRevision, createdAt])
}

model CustomerClarification {
  id               String                  @id @default(uuid())
  inquiryId        String
  inquiry          Inquiry                 @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  subject          String
  requestedAt      DateTime
  dueAt            DateTime
  followUpAt       DateTime
  responsibleId    String
  responsible      User                    @relation("ClarificationOwner", fields: [responsibleId], references: [id], onDelete: Restrict)
  createdById      String
  createdBy        User                    @relation("ClarificationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  customerHold     Boolean                 @default(false)
  escalationReason String?
  escalatedAt      DateTime?
  revision         Int                     @default(1)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  questions        ClarificationQuestion[]

  @@index([inquiryId, createdAt])
  @@index([responsibleId, dueAt])
  @@index([escalatedAt])
}

model ClarificationQuestion {
  id              String                  @id @default(uuid())
  clarificationId String
  clarification   CustomerClarification   @relation(fields: [clarificationId], references: [id], onDelete: Restrict)
  question        String
  reviewItemId    String?
  reviewItem      TechnicalReviewItem?    @relation(fields: [reviewItemId], references: [id], onDelete: Restrict)
  confirmation    ConfirmationState       @default(UNANSWERED)
  responses       ClarificationResponse[]

  @@index([clarificationId, confirmation])
  @@index([reviewItemId])
}

// Answers are append-only; a later answer never erases a customer's earlier message.
model ClarificationResponse {
  sequence     Int
  id           String                @id @default(uuid())
  questionId   String
  question     ClarificationQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)
  response     String
  receivedAt   DateTime
  confirmation ConfirmationState
  evidenceId   String
  evidence     InquiryEvidence       @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  recordedById String
  recordedBy   User                  @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime              @default(now())

  @@unique([questionId, sequence])
  @@index([questionId, createdAt])
  @@index([evidenceId])
}

model RequirementBaselineVersion {
  sourceFingerprint String
  id                String                       @id @default(uuid())
  inquiryId         String
  inquiry           Inquiry                      @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  reviewId          String
  review            InquiryTechnicalReview       @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  version           Int
  revision          Int                          @default(1)
  previousVersionId String?
  previousVersion   RequirementBaselineVersion?  @relation("BaselineRevision", fields: [previousVersionId], references: [id], onDelete: Restrict)
  revisions         RequirementBaselineVersion[] @relation("BaselineRevision")
  assumptions       String[]
  openQuestions     String[]
  changeReason      String
  outcome           BaselineOutcome              @default(CLARIFICATION_PENDING)
  frozenAt          DateTime?
  createdById       String
  createdBy         User                         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  assertions        BaselineAssertion[]

  @@unique([inquiryId, version])
  @@index([reviewId])
  @@index([previousVersionId])
}

model BaselineAssertion {
  id         String                     @id @default(uuid())
  baselineId String
  baseline   RequirementBaselineVersion @relation(fields: [baselineId], references: [id], onDelete: Restrict)
  key        String
  value      String
  confirmed  Boolean
  evidenceId String
  evidence   InquiryEvidence            @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([baselineId, key])
  @@index([evidenceId])
}

// Requests are immutable. A changed scope requires a new request and review.
// No grant-producing decision exists until specialized authority is mapped.
model ProvisionalReviewRequest {
  id                 String                      @id @default(uuid())
  inquiryId          String
  inquiry            Inquiry                     @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  reviewId           String
  review             InquiryTechnicalReview      @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  missingInformation Json
  proposedActivity   String
  unaffectedScope    String
  assumptions        String[]
  risks              String[]
  requestedById      String
  requestedBy        User                        @relation("ProvisionalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewerId         String
  reviewer           User                        @relation("ProvisionalReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  expiresAt          DateTime?
  createdAt          DateTime                    @default(now())
  decisions          ProvisionalReviewDecision[]

  @@index([inquiryId, createdAt])
  @@index([reviewerId, expiresAt])
  @@index([reviewId])
}

model ProvisionalReviewDecision {
  id           String                   @id @default(uuid())
  requestId    String                   @unique
  request      ProvisionalReviewRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  disposition  ProvisionalDisposition
  reason       String
  conditions   String[]
  recordedById String
  recordedBy   User                     @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt    DateTime                 @default(now())
}
