// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MANAGEMENT
  PRODUCTION
  MERCHANDISE
  MARKETING
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AuditActionType {
  REGISTERED
  APPROVED
  REJECTED
  SUSPENDED
  ROLE_CHANGED
  PASSWORD_CHANGED
  LOGIN_ATTEMPT
  LOGIN_FAILED
}

model User {
  id                String        @id @default(uuid())
  email             String        @unique
  passwordHash      String
  name              String
  role              Role          @default(PRODUCTION)
  status            AccountStatus @default(PENDING)
  department        String?
  isPasswordChanged Boolean       @default(false)
  loginAttempts     Int           @default(0)
  lastLoginAt       DateTime?
  lastLoginIp       String?
  lockedUntil       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime?      @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType    AuditActionType
  actionDetails String?
  performedBy   String?
  ipAddress     String?
  timestamp     DateTime          @default(now())

  @@index([userId])
  @@index([timestamp])
  @@index([actionType])
}


model OrderToken{
  id            String            @id @default(uuid())
  //productFamilies ProductFamily[] // Back-relation field

  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())
}

// MERCHANDISE Department

enum SampleType {
  APPROVAL_SAMPLE
  PHOTO_SAMPLE
  PPS
  PACKING_SAMPLE
}

enum InternalQcStatus {
  PENDING
  PASSED
  FAILED
}

enum CustomerSampleStatus {
  PENDING
  APPROVED
  DISAPPROVED
}

enum ReasonCategory {
  SHADE_MISMATCH
  MEASUREMENT_DEFECT
  CONSTRUCTION_ERROR
  FABRIC_QUALITY
  TRIM_PACKING_DEFECT
  OTHER
}

//PPS
model PreProductionSample {
  id              String               @id @default(uuid())
  icnNo           String
  sampleType      SampleType           @default(PPS)
  ppsVersion      Int                  @default(1)
  
  // Relational Link to OWI
  owiId           String
  owi             String  //OrderWorkingInstruction @relation(fields: [owiId], references: [id])

  rackId          String               // Storage rack reference (e.g., "1", "R-02")
  qcStatus        InternalQcStatus     @default(PENDING)
  isApproved      Boolean              @default(false) // Internal Management Sign-off
  isLocked        Boolean              @default(false)

  dispatchDate    DateTime?
  receivedDate    DateTime?
  
  status          CustomerSampleStatus @default(PENDING) // Customer Feedback Status
  reasonCategory  ReasonCategory?
  remarks         String?              @db.Text

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([icnNo])
  @@index([owiId])
  @@map("pre_production_samples")
}


// T&A Planning
enum StageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

enum Department {
  MERCHANDISING
  SCM
  PRODUCTION
  QUALITY
  ACCOUNTS
}

// 1. Parent T&A Header Model
model TimeActionPlan {
  id                 String           @id @default(uuid())
  icnNo              String
  owiId              String
  owi                String           //OrderWorkingInstruction @relation(fields: [owiId], references: [id])
  
  orderDate          DateTime
  shipmentDeadline   DateTime
  totalLeadTimeDays  Int              // Auto-calculated total duration
  
  // Relation: One T&A plan has many stages stored in a proper table
  stages             TimeActionStage[] 
  
  taVersion          Int              @default(1)
  isLocked           Boolean          @default(false)
  criticalPathFlag   Boolean          @default(false)

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([icnNo])
  @@index([owiId])
  @@map("time_action_plans")
}

// 2. Child Stage Model (Enforces Enums & Individual Database Rows)
model TimeActionStage {
  id                    String         @id @default(uuid())
  timeActionPlanId      String
  timeActionPlan        TimeActionPlan @relation(fields: [timeActionPlanId], references: [id], onDelete: Cascade)
  
  stageName             String
  plannedStartDate      DateTime?
  plannedEndDate        DateTime?
  actualStartDate       DateTime?
  actualEndDate         DateTime?
  
  // Optional until assigned during T&A planning
  responsibleDepartment Department?     
  status                StageStatus    @default(PENDING)

  @@index([timeActionPlanId])
  @@index([status])
  @@index([responsibleDepartment])
  @@map("time_action_stages")
}